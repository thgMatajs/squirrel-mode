{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}\"/scripts/load-profile.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}\"/scripts/check-off-flag.sh"
      },
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}\"/scripts/load-profile.sh"
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write|Read",
        "command": "\"${CURSOR_PLUGIN_ROOT}\"/scripts/allow-checkpoint.sh"
      }
    ]
  }
}
